{
    "name": "updater/timberland-ai-page-builder",
    "description": "Generate page/post layouts from natural language using Claude AI",
    "type": "wordpress-plugin",
    "require": {
        "php": ">=8.1",
        "anthropic-ai/sdk": "^0.1",
        "openai-php/client": "^0.10",
        "symfony/http-client": "^6.4 || ^7.0",
        "nyholm/psr7": "^1.8",
        "justinrainbow/json-schema": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "TimberlandAIPageBuilder\\": "includes/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "dealerdirect/phpcodesniffer-composer-installer": false
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test:unit": "phpunit --testsuite unit",
        "analyse": "phpstan analyse --memory-limit=768M",
        "analyse:baseline": "phpstan analyse --memory-limit=768M --generate-baseline=phpstan-baseline.neon",
        "sniff": "phpcs",
        "sniff:fix": "phpcbf",
        "check": [
            "@sniff",
            "@analyse",
            "@test"
        ]
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.4",
        "phpcsstandards/phpcsextra": "^1.5",
        "phpcsstandards/phpcsutils": "^1.0",
        "phpstan/phpstan": "^2.3",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "php-stubs/acf-pro-stubs": "^6.8",
        "brain/monkey": "^2.7"
    },
    "autoload-dev": {
        "psr-4": {
            "TimberlandAIPageBuilder\\Tests\\": "tests/"
        }
    }
}
